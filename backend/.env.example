# Copy to .env and fill in real values; .env is gitignored
# Local dev doesn't need DATABASE_URL — docker-compose supplies it.
# For deployment, set DATABASE_URL to your hosted Postgres:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Gemini API key (free tier) from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

SECRET_KEY=change-me

# Optional: an admin account auto-created/promoted at backend startup
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Find the Target web search. Gemini's Google Search grounding needs a
# billing-enabled project; without it, set a Serper key (google.serper.dev,
# 2,500 free searches) and searches fall back to live Google results.
# TARGET_SEARCH: auto (grounding, then Serper) | gemini | serper
SERPER_API_KEY=
TARGET_SEARCH=auto
TARGET_SEARCH_GL=my
